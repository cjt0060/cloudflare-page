---
import LinkedInIcon from "@/components/Icons/LinkedIn.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { socialUrls } from "@/config";

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Blog", href: "/blog" },
  { label: "Projects", href: "/projects" },
  { label: "Certifications", href: "/certifications" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-surface-800/50 bg-surface-950/80 backdrop-blur-xl">
  <div class="section-container">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-500 to-primary-700 flex items-center justify-center">
          <span class="text-white font-bold text-sm">CE</span>
        </div>
        <span class="font-semibold text-white group-hover:text-primary-400 transition-colors hidden sm:block">
          CloudEngineer
        </span>
      </a>

      <!-- Navigation -->
      <div class="flex items-center gap-1 sm:gap-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-astro-prefetch="tap"
            class:list={[
              "px-2 sm:px-3 py-2 text-sm rounded-md transition-colors duration-200",
              currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
                ? "text-primary-400 bg-primary-500/10"
                : "text-surface-400 hover:text-white hover:bg-surface-800/50",
            ]}
          >
            {link.label}
          </a>
        ))}

        <a
          href={socialUrls.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-2 sm:px-3 py-2 text-sm rounded-md text-surface-400 hover:text-white hover:bg-surface-800/50 transition-colors duration-200"
          aria-label="LinkedIn"
        >
          <LinkedInIcon class="w-4 h-4" />
          <span class="hidden sm:inline">LinkedIn</span>
        </a>

        <ThemeToggle label="Toggle theme" />
      </div>
    </div>
  </div>
</nav>

<div class="h-16"></div>
