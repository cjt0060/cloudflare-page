---
import BaseLayout from "@layouts/BaseLayout.astro";
import CertificationCard from "@components/CertificationCard.astro";
import { certifications } from "@/data/certifications";

const categories = [...new Set(certifications.map((c) => c.category))];
---

<BaseLayout title="Certifications" description="Professional cloud and infrastructure certifications — AWS, GCP, Azure, Kubernetes, Terraform.">
  <section class="section-padding">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-12">
          <h1 class="text-4xl sm:text-5xl font-bold text-white tracking-tight">Certifications</h1>
          <p class="mt-4 text-lg text-surface-400">
            Professional certifications validating expertise across cloud platforms and infrastructure technologies.
          </p>
        </div>

        <!-- Category filters -->
        <div id="cert-filters" class="flex flex-wrap gap-2 mb-10">
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="cert-filter px-3 py-1.5 text-sm rounded-lg border transition-colors bg-primary-500/10 text-primary-400 border-primary-500/20"
          >
            All ({certifications.length})
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              aria-pressed="false"
              class="cert-filter px-3 py-1.5 text-sm rounded-lg border transition-colors text-surface-400 border-surface-700 hover:border-surface-600"
            >
              {cat} ({certifications.filter((c) => c.category === cat).length})
            </button>
          ))}
        </div>

        <!-- Certifications Grid -->
        <div id="cert-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {certifications.map((cert) => (
            <div class="cert-item" data-category={cert.category}>
              <CertificationCard
                title={cert.title}
                issuer={cert.issuer}
                date={cert.date}
                credentialUrl={cert.credentialUrl}
                description={cert.description}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>(".cert-filter");
    const items = document.querySelectorAll<HTMLElement>(".cert-item");

    const activeClasses = ["bg-primary-500/10", "text-primary-400", "border-primary-500/20"];
    const inactiveClasses = ["text-surface-400", "border-surface-700", "hover:border-surface-600"];

    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selected = btn.dataset.filter;

        filters.forEach((f) => {
          const active = f === btn;
          f.setAttribute("aria-pressed", active ? "true" : "false");
          if (active) {
            f.classList.add(...activeClasses);
            f.classList.remove(...inactiveClasses);
          } else {
            f.classList.remove(...activeClasses);
            f.classList.add(...inactiveClasses);
          }
        });

        items.forEach((item) => {
          const category = item.dataset.category;
          const show = selected === "all" || category === selected;
          item.style.display = show ? "" : "none";
        });
      });
    });
  </script>
</BaseLayout>
