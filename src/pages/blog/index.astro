---
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogCard from "@components/BlogCard.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "@/utils/readingTime";

const allPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const categories = [...new Set(allPosts.map((p) => p.data.category))];
---

<BaseLayout title="Blog" description="Articles about cloud engineering, Kubernetes, AWS, Terraform, and platform engineering.">
  <section class="section-padding">
    <div class="section-container">
      <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="mb-12">
          <h1 class="text-4xl sm:text-5xl font-bold text-heading tracking-tight">Blog</h1>
          <p class="mt-4 text-lg text-surface-400 max-w-2xl">
            Thoughts on cloud engineering, DevOps practices, and lessons learned building infrastructure at scale.
          </p>
        </div>

        <!-- Category filters -->
        <div id="blog-filters" class="flex flex-wrap gap-2 mb-10">
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="blog-filter px-3 py-1.5 text-sm rounded-lg border transition-colors bg-primary-500/10 text-primary-400 border-primary-500/20"
          >
            All ({allPosts.length})
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              aria-pressed="false"
              class="blog-filter px-3 py-1.5 text-sm rounded-lg border transition-colors text-surface-400 border-surface-700 hover:border-surface-600"
            >
              {cat} ({allPosts.filter((p) => p.data.category === cat).length})
            </button>
          ))}
        </div>

        <!-- Posts Grid -->
        <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {allPosts.map((post) => (
            <div class="blog-item" data-category={post.data.category}>
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.publishedDate}
                category={post.data.category}
                readingTime={`${calculateReadingTime(post.body!)} min read`}
                href={`/blog/${post.slug}`}
                tags={post.data.tags}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>(".blog-filter");
    const items = document.querySelectorAll<HTMLElement>(".blog-item");

    const activeClasses = ["bg-primary-500/10", "text-primary-400", "border-primary-500/20"];
    const inactiveClasses = ["text-surface-400", "border-surface-700", "hover:border-surface-600"];

    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selected = btn.dataset.filter;

        filters.forEach((f) => {
          const active = f === btn;
          f.setAttribute("aria-pressed", active ? "true" : "false");
          if (active) {
            f.classList.add(...activeClasses);
            f.classList.remove(...inactiveClasses);
          } else {
            f.classList.remove(...activeClasses);
            f.classList.add(...inactiveClasses);
          }
        });

        items.forEach((item) => {
          const category = item.dataset.category;
          const show = selected === "all" || category === selected;
          item.style.display = show ? "" : "none";
        });
      });
    });
  </script>
</BaseLayout>
